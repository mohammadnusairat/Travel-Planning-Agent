# Backend settings. Copy to .env for local use; set these as Railway variables in production.
ANTHROPIC_API_KEY=

# Frontend origins allowed to call the API, comma separated (your Vercel production URL).
TRAVEL_CORS_ORIGINS=
# Optional regex for extra origins, e.g. Vercel preview deployments: ^https://your-project-[a-z0-9-]+\.vercel\.app$
TRAVEL_CORS_ORIGIN_REGEX=

# SQLite location. On Railway, point this at a mounted volume (the Dockerfile defaults to /data/travel_app.db).
TRAVEL_APP_DB=
# Railway only: lets the container (non-root user) write to the root-owned volume.
# RAILWAY_RUN_UID=0

# Optional
TRAVEL_AGENT_MODEL=claude-sonnet-4-6
TRAVEL_MAX_CONCURRENT_RUNS=2
